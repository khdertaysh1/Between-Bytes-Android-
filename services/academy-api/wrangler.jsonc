{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "between-bytes-academy-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"PUBLIC_ORIGINS": "https://khdertaysh1.github.io", "SITE_URL": "https://khdertaysh1.github.io/Between-Bytes-Android-/", "RETENTION_DAYS": "90"},
  "d1_databases": [{"binding": "DB", "database_name": "between-bytes-academy", "database_id": "d5e31394-de4d-4578-ab77-3e2c26f66239", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["17 3 * * *"]},
  "observability": {"enabled": false}
}
